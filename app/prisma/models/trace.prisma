model Trace {
  id        String      @id @db.Uuid
  path      String
  status    TraceStatus @default(RECEIVED)
  score     Int?
  caseId    String      @db.Uuid
  sha256    String?     @db.Char(64)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Métadonnées de capture (B1b). Toutes nullables : le chemin galerie et les
  // traces antérieures n'en portent aucune. `capturedAt` est la date de PRISE DE
  // VUE (EXIF), à ne pas confondre avec `createdAt`, date de réception serveur.
  captureWidth       Int?
  captureHeight      Int?
  capturedAt         DateTime?
  captureOrientation Int?
  captureFocalLength Float?
  captureDeviceModel String?

  // Contrôle de netteté relevé on-device au déclenchement (B2/B3), écrit par
  // POST /traces. Nullable : le chemin galerie et les traces antérieures n'en
  // portent aucun. La perpendicularité (MOB-11) a été abandonnée en B2.
  // Forme : { blurScore: number >= 0, passed: boolean }
  captureQuality Json?

  matchings Matching[]
  hits      Hit[]
}

enum TraceStatus {
  RECEIVED
  EXPLOITABLE
  NOT_EXPLOITABLE
}
