model Layer {
  id              String    @id @default(uuid()) @db.Uuid
  fingerprintId   String    @db.Uuid
  name            String    @db.VarChar(255)
  type            LayerType
  zIndex          Int
  isVisible       Boolean   @default(true)
  settings        Json
  createdByUserId String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  pairsAsTraceMinutia     MinutiaPair[] @relation("TraceSideMinutia")
  pairsAsReferenceMinutia MinutiaPair[] @relation("ReferenceSideMinutia")
}

enum LayerType {
  ANNOTATION
  FILTER
}
