model ReferencePrint {
  id        String          @id @db.Uuid
  path      String
  caseId    String          @db.Uuid
  sha256    String?         @db.Char(64)
  displayableSha256 String?         @db.Char(64)
  subjectId String?         @db.Uuid
  position  FingerPosition?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  withdrawnAt      DateTime?
  withdrawalMotive WithdrawalMotive?
  imageDestroyedAt DateTime?

  // Résolution calibrée par l'opérateur sur la règle photographiée (L5-4), en
  // points par pouce de l'image telle qu'elle a été déposée. L'absence ne se
  // confond pas avec un zéro : une empreinte non calibrée rend `null`.
  resolutionDpi Float?

  matchings Matching[]
  hits      Hit[]
}

enum FingerPosition {
  RIGHT_THUMB
  RIGHT_INDEX
  RIGHT_MIDDLE
  RIGHT_RING
  RIGHT_LITTLE
  LEFT_THUMB
  LEFT_INDEX
  LEFT_MIDDLE
  LEFT_RING
  LEFT_LITTLE
  RIGHT_PALM
  LEFT_PALM
  OTHER
}
